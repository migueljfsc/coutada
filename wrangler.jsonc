{
  // Deployed by .github/workflows/deploy-worker.yml. Locally: pnpm build && pnpm deploy:worker --dry-run
  //
  // Static assets are free and outside the 100k requests/day budget; only the paths in
  // run_worker_first invoke the script (D1). The hunt WebSocket lives under /api/.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coutada",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-26",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "routes": [{ "pattern": "coutada.migueljfsc.dev", "custom_domain": true }],
  "workers_dev": false,

  "vars": {
    "MAIL_FROM": "Coutada <noreply@coutada.migueljfsc.dev>",
    // The hunt objects run and store data only in the EU (D16). Local workerd does not implement
    // jurisdictions, so tests and .dev.vars blank it; src/share/deploy.test.ts holds it at "eu".
    "HUNT_JURISDICTION": "eu"
  },

  // The daily sweep of expired sessions, links, transfer codes and unused devices (worker/lib/cleanup.ts).
  "triggers": { "crons": ["23 4 * * *"] },

  // Per Cloudflare location, eventually consistent; the period is 10 or 60 seconds.
  // namespace_id is any integer unique within the account.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
    { "name": "MAP_LIMIT", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } }
  ],

  // One object per live hunt, SQLite-backed (the free plan's kind), used only through the EU
  // jurisdiction (D9, D16).
  "durable_objects": {
    "bindings": [{ "name": "HUNT", "class_name": "Hunt" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hunt"] }],

  // database_id comes from `tofu output d1_database_id` after the stack's first apply.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coutada-prod",
      "database_id": "b130d589-35ab-491a-b33e-a37beeccd4f5",
      "migrations_dir": "./worker/migrations"
    }
  ],

  "observability": { "enabled": true }
}
