{
  "name": "coutada",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "description": "Coordinate a hunt on a satellite map: named spots, routes, posts and zones, and everyone's live position.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm types && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "pnpm types && tsc -b --noEmit",
    "test": "pnpm types && vitest run",
    "test:watch": "vitest",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "6.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "terra-draw": "1.38.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "4.151.2"
  }
}
